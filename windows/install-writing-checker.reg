Windows Registry Editor Version 5.00

; Tells Word to load Writing Checker from C:\WordAddins\manifest.xml
; Double-click this file, click Yes, then restart Word.

[HKEY_CURRENT_USER\Software\Microsoft\Office\16.0\WEF\Developer]
"04d0d9bc-382d-49af-9505-a7f97fda7c6e"="C:\\WordAddins\\manifest.xml"
